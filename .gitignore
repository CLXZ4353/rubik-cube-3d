node_modules/
package-lock.json

# generated pre-computed solver tables (regenerate with npm run pregen).
# The small curated algorithm datasets are checked in so a clone works
# without regenerating anything.
data/*
!data/algdb/
!data/algdb/**
!data/cases/
!data/cases/keys/
!data/cases/keys/**

# screenshots + logs from the browser tests. shots/ is the one kept in the repo:
# README.md embeds shots/02_after_scramble.png as the preview image.
shots*/
!shots/
*_shots*/
shot*.png
*.log
tmp_srv.*

# Windows artifact of a `> nul` redirect
nul

# deploy staging dir (copy of the static files, built by hand for wrangler)
dist/

# scratch output from wrangler runs / one-off API probes
tmp_*.mjs
tmp_srv.*
wrangler_login.*

# exploratory one-off scripts (moved out of the real test set)
tests/scratch/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
